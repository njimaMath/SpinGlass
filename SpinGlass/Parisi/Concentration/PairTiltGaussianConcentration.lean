import SpinGlass.Parisi.Concentration.GaussianLipschitz
import SpinGlass.Parisi.Concentration.PairTiltDisorder

/-!
# Gaussian fluctuations of the actual logarithmic tilted mass

The interaction and root marks are linear images of one standard Gaussian
vector. Their explicit branch coefficient controls the concentration
constant, uniformly in the positive cascade levels and the external field.
-/

open MeasureTheory ProbabilityTheory Set
open scoped NNReal BigOperators RealInnerProductSpace

namespace SpinGlass

open FiniteGibbs

variable {N k : ℕ} {J : Type*} [Fintype J]
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- The interaction energy generated by a family of Gaussian coefficient
vectors. -/
noncomputable def pairGaussianInteraction (A : Config N → E) (w : E) : EnergySpace N :=
  WithLp.toLp 2 (fun σ => ⟪A σ, w⟫)

/-- The coefficient of the Gaussian vector in the full two-replica branch
Hamiltonian, including the root marks. -/
noncomputable def pairGaussianBranchCoeff (A : Config N → E) (B : Fin N × J → E)
    (K₀ : Fin 2 → J → ℝ) (σ : Fin 2 → Config N) : E :=
  A (σ 0) + A (σ 1) + ∑ l, ∑ i, spin N (σ l) i • ∑ j, K₀ l j • B (i, j)

/-- The actual branch Hamiltonian depends on the Gaussian coordinates
through its explicit linear coefficient. -/
theorem pairBranchHamX_gaussian_eq (A : Config N → E) (B : Fin N × J → E)
    (lam : ℝ) (a : Fin N × Fin 2 → ℝ)
    (K₀ : Fin 2 → J → ℝ) (K : Fin k → Fin 2 → J → ℝ)
    (w : E) (x : Fin k → Fin N × J → ℝ) (σ : Fin 2 → Config N) :
    pairBranchHamX N k (pairGaussianInteraction A w) lam a K₀ K
        (fun ij => ⟪B ij, w⟫) x σ =
      ⟪pairGaussianBranchCoeff A B K₀ σ, w⟫ +
        pairBranchHamX N k 0 lam a K₀ K 0 x σ := by
  simp [pairBranchHamX, pairBranchMark, pairGaussianInteraction, pairGaussianBranchCoeff,
    spin, spinOf, inner_add_left, sum_inner, real_inner_smul_left, mul_add,
    Finset.sum_add_distrib]
  ring

/-- The Gaussian-coordinate Lipschitz bound for the logarithmic constrained
mass. The same coefficient controls every positive cascade depth. -/
theorem lipschitzWith_pairHamLogTiltMass_gaussian
    (ms : Fin k → ℝ) (vs : Fin k → ℝ≥0)
    {c : (Fin 2 → Config N) → ℝ} (hc0 : ∀ σ, 0 ≤ c σ) (hc1 : ∀ σ, c σ ≤ 1)
    (hcpos : ∃ σ, 0 < c σ) (hsm : StrictMono ms)
    (hpos : ∀ i, 0 < ms i) (hlt : ∀ i, ms i < 1)
    (A : Config N → E) (B : Fin N × J → E) (lam : ℝ) (a : Fin N × Fin 2 → ℝ)
    (K₀ : Fin 2 → J → ℝ) (K : Fin k → Fin 2 → J → ℝ)
    {C : ℝ≥0} (hC : ∀ σ, ‖pairGaussianBranchCoeff A B K₀ σ‖ ≤ C) :
    LipschitzWith (2 * C) (fun w => pairHamLogTiltMass ms vs c
      (pairGaussianInteraction A w) lam a K₀ K (fun ij => ⟪B ij, w⟫)) := by
  apply LipschitzWith.of_dist_le_mul
  intro w w'
  rw [Real.dist_eq]
  have hb (x : Fin k → Fin N × J → ℝ) (σ : Fin 2 → Config N) :
      |pairBranchHamX N k (pairGaussianInteraction A w) lam a K₀ K
          (fun ij => ⟪B ij, w⟫) x σ -
        pairBranchHamX N k (pairGaussianInteraction A w') lam a K₀ K
          (fun ij => ⟪B ij, w'⟫) x σ| ≤ C * dist w w' := by
    rw [pairBranchHamX_gaussian_eq, pairBranchHamX_gaussian_eq,
      add_sub_add_right_eq_sub, ← inner_sub_right, dist_eq_norm]
    exact (abs_real_inner_le_norm _ _).trans
      (mul_le_mul_of_nonneg_right (hC σ) (norm_nonneg _))
  have hh := abs_pairHamLogTiltMass_sub_le_of_hamiltonian_bound ms vs hc0 hc1 hcpos
    hsm hpos hlt (pairGaussianInteraction A w) (pairGaussianInteraction A w')
    lam a a K₀ K (fun ij => ⟪B ij, w⟫) (fun ij => ⟪B ij, w'⟫) hb
  simpa only [NNReal.coe_mul, NNReal.coe_ofNat, mul_assoc] using hh

/-- Gaussian concentration of the actual weighted cascade logarithm.
The explicit coefficient bound includes both disorder and root marks;
no smoothness, field moment, or pressure-gap hypothesis is needed. -/
theorem hasSubgaussianMGF_pairHamLogTiltMass_gaussian
    [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
    (ms : Fin k → ℝ) (vs : Fin k → ℝ≥0)
    {c : (Fin 2 → Config N) → ℝ} (hc0 : ∀ σ, 0 ≤ c σ) (hc1 : ∀ σ, c σ ≤ 1)
    (hcpos : ∃ σ, 0 < c σ) (hsm : StrictMono ms)
    (hpos : ∀ i, 0 < ms i) (hlt : ∀ i, ms i < 1)
    (A : Config N → E) (B : Fin N × J → E) (lam : ℝ) (a : Fin N × Fin 2 → ℝ)
    (K₀ : Fin 2 → J → ℝ) (K : Fin k → Fin 2 → J → ℝ)
    {C : ℝ≥0} (hC : ∀ σ, ‖pairGaussianBranchCoeff A B K₀ σ‖ ≤ C) :
    let F := fun w => pairHamLogTiltMass ms vs c (pairGaussianInteraction A w)
      lam a K₀ K (fun ij => ⟪B ij, w⟫)
    HasSubgaussianMGF (fun w => F w - ∫ w', F w' ∂stdGaussian E)
      ((2 * C) ^ 2) (stdGaussian E) :=
  hasSubgaussianMGF_stdGaussian_sub_integral_of_lipschitz
    (lipschitzWith_pairHamLogTiltMass_gaussian ms vs hc0 hc1 hcpos hsm hpos hlt
      A B lam a K₀ K hC)

end SpinGlass
